                                                    "spacing": "$MinimumSpacing"
                                                }
                                            }
                                        },
                                        {
                                            "type": "ButtonWidget", "name": "AcceptInvite",
                                            "fields": {
                                                "rect": { "x": 617, "y": 30 },
