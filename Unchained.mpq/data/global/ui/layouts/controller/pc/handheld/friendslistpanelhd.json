                                                "tooltipString": "@ControllerPromptModalAccept",
                                                "hoveredFrame":1
                                            }
                                        },
                                        {
                                            "type": "ButtonWidget", "name": "RejectInvite",
                                            "fields": {
                                                "rect": { "x": 686, "y": 30 },
                                                "filename":  "Lobby\\FriendsList\\FriendsList_RejectInvite_Button",
                                                "onClickMessage": "FriendsListMessage:RejectInvite",
